# Single source of truth for the engine the images build (katago-rs), a sibling
# checkout (it's a subprocess, built in the image, not a crate dependency).
# muxa and pgmq are git deps pinned by rev in Cargo.toml / Cargo.lock.
# Read by .github/actions/checkout-siblings and every workflow that builds the
# images. Bumping a pin is a deliberate, single-line, reviewable change here —
# it must not drift between workflows.
KATAGO_RS_REPO=Sagebati/katago-rs
KATAGO_RS_REF=7ebdc9c57958e888cb5ffdebeaea2887befa8e1a
