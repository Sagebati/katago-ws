# Single source of truth for the sibling repos this crate path-depends on
# (see Cargo.toml: muxa = { path = "../muxa/..." }, pgmq = { path = "../pgmq/..." }).
# Read by .github/actions/checkout-siblings and every workflow that builds this
# crate. Bumping a pin is a deliberate, single-line, reviewable change here —
# it must not drift between workflows.
MUXA_REPO=Sagebati/muxa
MUXA_REF=a4a6c17974d4205b70e2bd75d517ef1810b723a8
PGMQ_REPO=Sagebati/pgmq
PGMQ_REF=1ad05960c924c26a3c5d2269017ac10164482404
